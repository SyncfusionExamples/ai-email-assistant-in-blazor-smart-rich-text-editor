@page "/"

@rendermode InteractiveServer
@using Syncfusion.Blazor.SmartRichTextEditor
@using Syncfusion.Blazor.RichTextEditor
@using Syncfusion.Blazor.Inputs


<div class="form-group">
    <label>To:</label>
    <SfTextBox Value="john.doe@company.com" />
</div>

<div class="form-group">
    <label>Subject:</label>
    <SfTextBox Value="Project Update - Q4 Deliverables"></SfTextBox>
</div>



<SfSmartRichTextEditor>
    <p>Hi Team,</p>
    <p>I’m writing to share a concise update on our Q4 deliverables and the next steps to keep momentum.</p>
    <ul>
    <li><strong>Phase 1:</strong> Completed ahead of schedule; all acceptance criteria have been met.</li>
    <li><strong>Budget:</strong> Results show a 15% cost reduction compared to initial estimates.</li>
    <li><strong>Phase 2 Timeline:</strong> Proposed timeline is ready for review. Please check the schedule
    and highlight any conflicts.</li>
    <li><strong>Client Feedback:</strong> Initial feedback is positive; the next client review is scheduled
    for Monday at 10:00 AM.</li>
    </ul>
    <p>Action requested: Please review the proposed Phase 2 timeline and reply with any concerns or suggested 
    adjustments by end of day Thursday. If I don’t hear objections, we’ll proceed with the current plan.</p> 
    <p>Thank you for your continued support.</p> <p>Best regards,</p>

    <AssistViewSettings Placeholder="Ask AI to expand, adjust tone, or improve your email..."
    Commands="@commands">
    </AssistViewSettings>

</SfSmartRichTextEditor>
@code{
    private List<AICommands> commands = new()
    {
        new AICommands
        {
            Text = "🎙️ Quick Tone Adjustments",
               Items = new List<AICommands>
               {
                 new AICommands { Text="💼 Professional",
                 Prompt = "Rewrite the mail content into a professional, polished business email tone while preserving meaning and key points"},
                 new AICommands { Text = "😊 Friendly",
                 Prompt = "Rewrite the mail content in a warm, conversational tone suitable for colleagues, maintaining clarity and intent" },
                 new AICommands { Text = "🎩 Formal",
                 Prompt = "Rewrite the mail content in a formal, respectful tone with concise phrasing appropriate for external stakeholders" },
                 new AICommands { Text = "⚡ Concise",
                 Prompt = "Shorten the mail content to be direct and to-the-point while keeping essential information and action items" },
                 new AICommands { Text = "❤️ Empathetic",
                 Prompt = "Rewrite the mail content with an empathetic, supportive tone that acknowledges concerns and encourages collaboration" },
               }
        },
        new AICommands
        {
            Text = "📧 Email Format",
               Items = new List<AICommands>
               {
                 new AICommands { Text = "📈 Business",
                 Prompt = "Convert the mail content into a clear, professional business email style focusing on actions and outcomes" },
                 new AICommands { Text = "⚖️ Legal",
                 Prompt = "Convert the mail content into a formal legal style: precise, unambiguous, and factual without adding new claims" },
                 new AICommands { Text = "📰 Journalistic",
                 Prompt = "Convert the mail content into a concise journalistic summary: lead with the key point and present facts objectively" },
                 new AICommands { Text = "🛠️ Technical",
                 Prompt = "Convert the mail content into a technical email style: use precise terminology, focus on implementation details, assumptions, and next steps." }
               }
        },
         new AICommands { Text = "✏️ Check Grammar & Spelling",
         Prompt = "Review the mail content for grammar, punctuation, and spelling errors; correct mistakes while preserving original meaning" },
    };
}
<style>
    .email-header {
        padding: 20px;
        border: 1px solid #ddd;
        border-radius: 6px;
        margin-bottom: 20px;
    }

    .form-group {
        display: flex;
        align-items: center;
        margin-bottom: 15px;
    }

    .form-group label {
        width: 80px;
        font-weight: 600;
    }
</style>




